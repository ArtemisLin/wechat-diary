# wechat-diary 配置模板
# 使用方法: 复制本文件为 .env, 按注释填入你自己的值
#
#   cp .env.example .env
#
# 千万不要把填好的 .env 提交到 git (已在 .gitignore 中排除)

# === 必填 (只有 2 项) ===

# iLink 扫码登录后返回的 ilink_user_id
# 先跑 `cd src && py ilink.py login` (Windows) 或 `python ilink.py login`, 扫码确认后把打印出的 ID 粘到这里
USER_ID=

# 日记存放目录的绝对路径 (目录不存在会自动创建)
# 用 Obsidian 的话, 填你的 vault 路径; 不用 Obsidian 的话, 任意目录都行
# 示例:
#   Windows: D:/Obsidian/MyDiary  或  C:/Users/<你的用户名>/Documents/MyDiary
#   macOS:   /Users/<你的用户名>/Documents/MyDiary
#   Linux:   /home/<你的用户名>/obsidian/MyDiary
# 想手机也能同步看: 放到 OneDrive / 坚果云 / iCloud / Dropbox 等云盘同步目录下
DIARY_DIR=

# === AI (v0.3 起暂停用) ===

# v0.3 是纯机械记录: 原文直存, 不发任何 LLM 请求——填了也没用。
# 字段为将来 AI 作为可选功能回归时保留 (DeepSeek / 任何 OpenAI 协议兼容服务)。
AI_API_KEY=

# === 可选: 默认就够用 ===

AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat

# 提醒时间 (0-23, 按下面 TIMEZONE 所在时区)
TIMEZONE=Asia/Shanghai
REMIND_HOUR_1=22
REMIND_HOUR_2=23

# 一天的边界 (0-12): 凌晨几点前记的算前一天。默认 4 = 熬夜到凌晨 3 点写的还算"今晚"
# (数据契约 v1.2)。与 Obsidian 插件版一致。
DAY_START_HOUR=4

# === 网络 ===
# iLink API 强制直连 ilinkai.weixin.qq.com, 不走代理 (踩坑经验: 走 Clash 会 TLS 超时)
# 以下 ILINK_PROXY_* 已废弃, 保留仅作向后兼容, 可不配置
ILINK_PROXY_MODE=proxy
ILINK_PROXY_URL=http://127.0.0.1:7890

# AI API (DeepSeek) 可选代理:
#   auto:   先直连, 失败时自动尝试本地代理 (推荐)
#   direct: 强制直连
#   proxy:  强制走 AI_PROXY_URL
AI_PROXY_MODE=auto
AI_PROXY_URL=http://127.0.0.1:7890
